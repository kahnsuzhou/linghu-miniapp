<!-- 支付密码键盘弹窗 -->
<view class="pay-mask" wx:if="{{show}}" bindtap="_onMaskTap"></view>
<view class="pay-sheet {{show ? 'show' : ''}}">

  <!-- 头部 -->
  <view class="pay-header">
    <view class="pay-close" bindtap="cancel">×</view>
    <view class="pay-title">{{title || '输入支付密码'}}</view>
    <view class="pay-amount-wrap" wx:if="{{amount}}">
      <text class="pay-amount-label">支付金额</text>
      <text class="pay-amount-value">¥{{amount}}</text>
    </view>
  </view>

  <!-- 密码圆点区 -->
  <view class="pwd-dots">
    <view wx:for="{{6}}" wx:key="*this" class="pwd-cell">
      <view class="pwd-dot {{inputLen > index ? 'filled' : ''}}"></view>
    </view>
  </view>

  <!-- 错误提示 -->
  <view class="pwd-error" wx:if="{{errorMsg}}">{{errorMsg}}</view>

  <!-- 忘记密码 / 提示 -->
  <view class="pwd-hint-row">
    <text class="pwd-hint" bindtap="_onForgot">忘记密码？</text>
  </view>

  <!-- 数字键盘 -->
  <view class="keyboard">
    <view wx:for="{{keys}}" wx:key="*this"
      class="key-btn {{item === '' ? 'key-empty' : ''}} {{item === '⌫' ? 'key-del' : ''}}"
      bindtap="_onKeyTap" data-key="{{item}}">
      <text>{{item}}</text>
    </view>
  </view>

</view>
