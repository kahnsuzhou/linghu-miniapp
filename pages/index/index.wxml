<!-- pages/index/index.wxml -->
<view class="page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索附近商品"
        value="{{searchKeyword}}"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <text wx:if="{{searchKeyword}}" class="search-clear" bindtap="onClearSearch">✕</text>
    </view>
  </view>

  <!-- 定位提示 -->
  <view class="location-bar" wx:if="{{locGranted}}">
    <text class="loc-icon">📍</text>
    <text class="loc-text">显示附近3km有货商品</text>
  </view>

  <!-- 加载骨架屏 -->
  <view wx:if="{{loading}}" class="skeleton-wrap">
    <view class="skeleton-card" wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this">
      <view class="skeleton-img"></view>
      <view class="skeleton-line long"></view>
      <view class="skeleton-line short"></view>
    </view>
  </view>

  <!-- 商品列表 -->
  <scroll-view
    wx:elif="{{products.length > 0}}"
    scroll-y
    class="product-scroll"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="product-grid">
      <view
        class="product-card"
        wx:for="{{products}}"
        wx:key="productId"
        bindtap="onProductTap"
        data-id="{{item.productId}}"
        data-warehouse-id="{{item.warehouseId}}"
      >
        <!-- 商品图 -->
        <view class="product-img-wrap">
          <image
            class="product-img"
            src="{{item.thumb}}"
            mode="aspectFill"
            lazy-load
          />
          <view class="stock-badge" wx:if="{{item.stockOut}}">已售罄</view>
          <view class="stock-badge warn" wx:elif="{{item.stockLow}}">仅剩{{item.stock}}件</view>
        </view>
        <!-- 商品信息 -->
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <view class="product-meta">
            <text class="distance">📍{{item.distance}}</text>
            <text class="wh-name">{{item.warehouseName}}</text>
          </view>
          <view class="product-bottom">
            <view class="price">
              <text class="price-symbol">¥</text>
              <text class="price-num">{{item.priceStr}}</text>
            </view>
            <view class="delivery-tag">⚡30分钟达</view>
          </view>
        </view>
      </view>
    </view>
    <view class="list-bottom">没有更多了</view>
  </scroll-view>

  <!-- 空状态 -->
  <view wx:elif="{{!loading}}" class="empty">
    <text class="empty-icon">🛒</text>
    <text class="empty-text">附近暂无商品，换个关键词试试</text>
  </view>
</view>
