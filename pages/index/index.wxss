/* pages/index/index.wxss */

/* 容器 */
.container {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 顶部搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  gap: 12rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.location-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #FF6B35;
  white-space: nowrap;
  flex-shrink: 0;
  background: none;
  border: none;
  padding: 0;
  line-height: 1;
}
.location-btn::after { border: none; }

.location-icon {
  font-size: 26rpx;
}

.city-name {
  max-width: 80rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 0 20rpx;
  height: 64rpx;
  gap: 8rpx;
}

.search-icon {
  font-size: 28rpx;
  color: #999;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.search-input-placeholder {
  color: #bbb;
}

/* 定位提示条 */
.location-tip {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #fff7f3;
  border-bottom: 1rpx solid #ffe8d6;
  gap: 8rpx;
}

.tip-text {
  flex: 1;
  font-size: 22rpx;
  color: #FF6B35;
}

.tip-action {
  font-size: 22rpx;
  color: #FF6B35;
  font-weight: bold;
  padding: 4rpx 16rpx;
  border: 1rpx solid #FF6B35;
  border-radius: 20rpx;
}

/* 骨架屏 */
.skeleton-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 16rpx;
}

.skeleton-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.skeleton-img {
  width: 100%;
  height: 260rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 400% 100%;
  animation: skeleton-shine 1.2s infinite;
}

.skeleton-info {
  padding: 16rpx;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  margin-bottom: 12rpx;
}

.skeleton-line.short {
  width: 60%;
}

@keyframes skeleton-shine {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* 商品列表区 */
.product-section {
  padding: 0 16rpx 120rpx;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx 12rpx;
  gap: 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.section-count {
  font-size: 22rpx;
  color: #999;
}

/* 商品网格 */
.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

/* 商品卡片 */
.product-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  transition: transform 0.15s;
}

.product-card:active {
  transform: scale(0.97);
}

.card-img-wrap {
  position: relative;
  width: 100%;
  height: 260rpx;
}

.card-img {
  width: 100%;
  height: 100%;
}

.sold-out-mask {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sold-out-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  border: 3rpx solid #fff;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
}

.stock-badge {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  background: rgba(255, 107, 53, 0.9);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.card-info {
  padding: 16rpx;
}

.card-name {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 10rpx;
}

.meta-icon {
  font-size: 20rpx;
}

.card-distance {
  font-size: 20rpx;
  color: #999;
}

.card-warehouse {
  font-size: 20rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 120rpx;
}

.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6rpx;
}

.card-price {
  font-size: 30rpx;
  font-weight: bold;
  color: #FF6B35;
}

.price-unit {
  font-size: 22rpx;
}

.flash-tag {
  font-size: 18rpx;
  color: #FF6B35;
  background: #fff3ed;
  border: 1rpx solid #ffcfb8;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}

/* 空状态 */
.empty-wrap {
  padding: 100rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-sub {
  display: block;
  font-size: 24rpx;
  color: #bbb;
}
