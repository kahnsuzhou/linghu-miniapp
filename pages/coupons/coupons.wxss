/* pages/coupons/coupons.wxss */

.container {
  background: #f5f5f5;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Tab */
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 0;
  position: relative;
}
.tab-label { font-size: 26rpx; color: #666; padding-bottom: 16rpx; }
.tab-item.active .tab-label { color: #FF6B35; font-weight: bold; }
.tab-line {
  position: absolute; bottom: 0;
  width: 40rpx; height: 4rpx;
  background: #FF6B35; border-radius: 2rpx;
}

/* 列表 */
.coupon-list { flex: 1; overflow: hidden; }
.list-wrap { padding: 20rpx 24rpx; }

/* 空状态 */
.empty-wrap {
  padding: 120rpx 0 60rpx;
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
}
.empty-icon { font-size: 100rpx; }
.empty-title { font-size: 30rpx; color: #999; }
.empty-sub { font-size: 24rpx; color: #bbb; }
.btn-go {
  margin-top: 12rpx;
  padding: 16rpx 48rpx;
  background: #FF6B35; color: #fff;
  border-radius: 40rpx; font-size: 28rpx; border: none;
}
.btn-go::after { border: none; }

/* 优惠券卡片 */
.coupon-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  position: relative;
}

.coupon-card.disabled {
  filter: grayscale(50%);
  opacity: 0.7;
}

.coupon-left {
  width: 180rpx;
  background: linear-gradient(135deg, #FF6B35, #ff8c5a);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 16rpx;
  flex-shrink: 0;
}

.discount-amount {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1.1;
}
.discount-condition {
  font-size: 20rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 6rpx;
  text-align: center;
}

/* 分隔虚线 */
.coupon-divider {
  width: 24rpx;
  flex-shrink: 0;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
}

.circle {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #f5f5f5;
  flex-shrink: 0;
}

.dash-line {
  flex: 1;
  width: 1rpx;
  background: repeating-linear-gradient(
    to bottom,
    #ddd 0rpx, #ddd 8rpx,
    transparent 8rpx, transparent 16rpx
  );
}

/* 右侧信息 */
.coupon-right {
  flex: 1;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #222;
}
.coupon-desc { font-size: 22rpx; color: #999; }
.coupon-expire { font-size: 20rpx; color: #bbb; }

.use-tag {
  font-size: 22rpx;
  color: #FF6B35;
  font-weight: 500;
  margin-top: 4rpx;
}
.used-tag, .expired-tag {
  font-size: 22rpx;
  margin-top: 4rpx;
}
.used-tag { color: #999; }
.expired-tag { color: #bbb; }
