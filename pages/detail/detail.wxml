<!-- pages/detail/detail.wxml -->
<view class="container">

  <!-- 骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="skeleton-swiper"></view>
    <view class="skeleton-body">
      <view class="skeleton-line lg"></view>
      <view class="skeleton-line sm"></view>
      <view class="skeleton-line md"></view>
    </view>
  </block>

  <!-- 正文 -->
  <block wx:elif="{{product}}">

    <!-- 图片轮播 -->
    <swiper class="img-swiper" indicator-dots="{{product.imageList.length > 1}}"
      indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#fff"
      autoplay circular bindchange="onImgChange">
      <swiper-item wx:for="{{product.imageList}}" wx:key="index">
        <image class="swiper-img" src="{{item}}" mode="aspectFill"
          bindtap="previewImg" data-index="{{index}}" />
      </swiper-item>
    </swiper>
    <!-- 图片计数 -->
    <view class="img-counter">{{currentImgIndex + 1}}/{{product.imageList.length}}</view>

    <!-- 价格 + 名称 -->
    <view class="info-card">
      <view class="price-row">
        <text class="price-main">¥{{product.priceStr}}</text>
        <text wx:if="{{product.originalPriceStr}}" class="price-original">¥{{product.originalPriceStr}}</text>
        <view wx:if="{{product.stockLow}}" class="stock-tip">仅剩{{product.stockLeft}}件</view>
        <view wx:if="{{product.soldOut}}" class="stock-tip sold-out">已售罄</view>
      </view>
      <view class="product-name">{{product.name}}</view>
      <view class="product-tags">
        <text class="tag tag-orange">⚡ 30分钟达</text>
        <text wx:if="{{product.isOrganic}}" class="tag tag-green">有机认证</text>
        <text wx:if="{{product.isFresh}}" class="tag tag-green">新鲜直采</text>
      </view>
    </view>

    <!-- 配送信息 -->
    <view class="section-card">
      <view class="section-row">
        <text class="row-label">配送方式</text>
        <text class="row-value">🚚 自提 · {{product.distanceStr ? product.distanceStr + ' · ' : ''}}{{product.warehouseName}}</text>
      </view>
      <view class="section-row">
        <text class="row-label">预计送达</text>
        <text class="row-value highlight">下单后 30 分钟内</text>
      </view>
    </view>

    <!-- 商品详情 -->
    <view class="section-card">
      <view class="section-title">商品详情</view>
      <view class="detail-content">
        <text>{{product.description || '暂无详情介绍'}}</text>
      </view>
    </view>

    <!-- 底部安全区占位 -->
    <view style="height: 140rpx;"></view>
  </block>

  <!-- 加载失败 -->
  <block wx:else>
    <view wx:if="{{!loading}}" class="empty-wrap">
      <text class="empty-icon">😕</text>
      <text class="empty-title">加载失败</text>
      <button class="btn-retry" bindtap="_loadDetail" data-id="{{productId}}">重新加载</button>
    </view>
  </block>

  <!-- 底部购买栏 -->
  <view class="buy-bar" wx:if="{{product}}">
    <view class="qty-wrap">
      <button class="qty-btn" bindtap="changeQty" data-action="minus">−</button>
      <text class="qty-num">{{quantity}}</text>
      <button class="qty-btn" bindtap="changeQty" data-action="plus">+</button>
    </view>
    <button class="btn-buy {{product.soldOut ? 'disabled' : ''}}"
      bindtap="buyNow" disabled="{{product.soldOut}}">
      {{product.soldOut ? '已售罄' : '立即下单'}}
    </button>
  </view>

</view>
