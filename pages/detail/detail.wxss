/* pages/detail/detail.wxss */

.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 骨架 */
.skeleton-swiper {
  width: 100%;
  height: 560rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 400% 100%;
  animation: shine 1.2s infinite;
}
.skeleton-body { padding: 24rpx; }
.skeleton-line {
  height: 28rpx; border-radius: 14rpx; background: #f0f0f0; margin-bottom: 16rpx;
}
.skeleton-line.lg { width: 60%; }
.skeleton-line.md { width: 80%; }
.skeleton-line.sm { width: 40%; }
@keyframes shine {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* 轮播 */
.img-swiper {
  width: 100%;
  height: 560rpx;
  background: #fff;
}
.swiper-img { width: 100%; height: 100%; }

.img-counter {
  position: fixed;
  top: 520rpx;
  right: 20rpx;
  background: rgba(0,0,0,0.45);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  z-index: 5;
}

/* 信息卡 */
.info-card {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.price-main {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF6B35;
}

.price-original {
  font-size: 26rpx;
  color: #bbb;
  text-decoration: line-through;
}

.stock-tip {
  font-size: 22rpx;
  color: #FF6B35;
  background: #fff3ed;
  border: 1rpx solid #ffcfb8;
  border-radius: 20rpx;
  padding: 4rpx 12rpx;
}
.stock-tip.sold-out {
  color: #999;
  background: #f5f5f5;
  border-color: #ddd;
}

.product-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #222;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.product-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.tag-orange { color: #FF6B35; background: #fff3ed; border: 1rpx solid #ffcfb8; }
.tag-green { color: #4caf50; background: #f0faf0; border: 1rpx solid #b8ddb8; }

/* 信息区块 */
.section-card {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #222;
  margin-bottom: 16rpx;
}

.section-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 16rpx;
}
.section-row:last-child { border-bottom: none; }

.row-label {
  font-size: 26rpx;
  color: #999;
  width: 140rpx;
  flex-shrink: 0;
}

.row-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.row-value.highlight {
  color: #4caf50;
  font-weight: 500;
}

.detail-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

/* 空状态 */
.empty-wrap {
  padding: 120rpx 0;
  text-align: center;
}
.empty-icon { font-size: 100rpx; display: block; margin-bottom: 20rpx; }
.empty-title { display: block; font-size: 30rpx; color: #999; margin-bottom: 24rpx; }
.btn-retry {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}
.btn-retry::after { border: none; }

/* 底部购买栏 */
.buy-bar {
  position: fixed;
  bottom: 0;
  left: 0; right: 0;
  height: 100rpx;
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.08);
  z-index: 100;
}

.qty-wrap {
  display: flex;
  align-items: center;
  gap: 0;
  border: 1rpx solid #eee;
  border-radius: 40rpx;
  overflow: hidden;
}

.qty-btn {
  width: 64rpx;
  height: 64rpx;
  background: #f5f5f5;
  color: #333;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1;
  padding: 0;
  border-radius: 0;
}
.qty-btn::after { border: none; }

.qty-num {
  width: 64rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.btn-buy {
  flex: 1;
  height: 80rpx;
  background: linear-gradient(135deg, #FF6B35, #ff8c5a);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-buy::after { border: none; }
.btn-buy.disabled {
  background: #ccc;
}
