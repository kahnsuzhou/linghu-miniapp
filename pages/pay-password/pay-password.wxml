<!-- pages/pay-password/pay-password.wxml -->
<view class="container">

  <view class="tip-card">
    <text class="tip-icon">🔐</text>
    <text class="tip-title">{{hasPassword ? '修改支付密码' : '设置支付密码'}}</text>
    <text class="tip-desc">支付密码用于钱包余额支付，请设置6位数字密码</text>
  </view>

  <view class="step-card" wx:if="{{step === 'input'}}">
    <view class="step-label">输入新密码</view>
    <view class="pwd-dots">
      <view wx:for="{{6}}" wx:key="*this" class="pwd-cell">
        <view class="pwd-dot {{pwd1.length > index ? 'filled' : ''}}"></view>
      </view>
    </view>
  </view>

  <view class="step-card" wx:if="{{step === 'confirm'}}">
    <view class="step-label">再次确认密码</view>
    <view class="pwd-dots">
      <view wx:for="{{6}}" wx:key="*this" class="pwd-cell">
        <view class="pwd-dot {{pwd2.length > index ? 'filled' : ''}}"></view>
      </view>
    </view>
    <view class="pwd-error" wx:if="{{errorMsg}}">{{errorMsg}}</view>
  </view>

  <!-- 数字键盘（始终显示） -->
  <view class="keyboard">
    <view wx:for="{{keys}}" wx:key="*this"
      class="key-btn {{item === '' ? 'key-empty' : ''}} {{item === '⌫' ? 'key-del' : ''}}"
      bindtap="onKeyTap" data-key="{{item}}">
      <text>{{item}}</text>
    </view>
  </view>

</view>
