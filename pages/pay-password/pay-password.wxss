/* pages/pay-password/pay-password.wxss */
.container {
  background: #f5f5f5;
  min-height: 100vh;
}

.tip-card {
  background: #fff;
  padding: 48rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.tip-icon { font-size: 72rpx; }
.tip-title { font-size: 34rpx; font-weight: bold; color: #222; }
.tip-desc { font-size: 24rpx; color: #999; text-align: center; line-height: 1.6; }

.step-card {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}
.step-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
  text-align: center;
}

.pwd-dots {
  display: flex;
  border: 1rpx solid #ebebeb;
  border-radius: 12rpx;
  overflow: hidden;
}
.pwd-cell {
  flex: 1;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #ebebeb;
}
.pwd-cell:last-child { border-right: none; }
.pwd-dot {
  width: 20rpx; height: 20rpx;
  border-radius: 50%;
  background: transparent;
  border: 2rpx solid #ddd;
}
.pwd-dot.filled { background: #222; border-color: #222; }

.pwd-error {
  text-align: center;
  font-size: 24rpx;
  color: #ff4444;
  margin-top: 16rpx;
}

.keyboard {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rpx;
  background: #d1d3d8;
  position: fixed;
  bottom: 0; left: 0; right: 0;
  padding-bottom: env(safe-area-inset-bottom);
}
.key-btn {
  background: #fff;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #333;
  font-weight: 500;
}
.key-btn:active { background: #e8e8e8; }
.key-empty { background: #d1d3d8; }
.key-empty:active { background: #d1d3d8; }
.key-del { background: #d1d3d8; font-size: 44rpx; color: #555; }
.key-del:active { background: #bfc1c7; }
