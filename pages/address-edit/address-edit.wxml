<!-- pages/address-edit/address-edit.wxml -->
<view class="container">
  <view class="form-card">

    <view class="form-item">
      <text class="label">联系人</text>
      <input class="input" placeholder="请输入联系人姓名"
        value="{{form.name}}" bindinput="onInput" data-field="name" maxlength="20" />
    </view>

    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" placeholder="请输入手机号" type="number"
        value="{{form.phone}}" bindinput="onInput" data-field="phone" maxlength="11" />
    </view>

    <view class="form-item" bindtap="chooseRegion">
      <text class="label">所在地区</text>
      <view class="region-wrap">
        <text class="region-text {{form.province ? '' : 'placeholder'}}">
          {{form.province || form.city || form.district ? (form.province + form.city + form.district) : '点击选择省/市/区'}}
        </text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="form-item">
      <text class="label">详细地址</text>
      <input class="input" placeholder="街道、楼栋、门牌号等"
        value="{{form.detail}}" bindinput="onInput" data-field="detail" maxlength="100" />
    </view>

  </view>

  <view class="save-bar">
    <button class="btn-save" bindtap="save" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存地址'}}
    </button>
  </view>
</view>
