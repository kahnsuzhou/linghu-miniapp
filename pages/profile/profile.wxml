<!-- pages/profile/profile.wxml -->
<view class="container">

  <!-- 顶部用户信息区 -->
  <view class="header-bg">
    <!-- 未登录 -->
    <view wx:if="{{!isLoggedIn}}" class="user-row">
      <view class="avatar-wrap default-avatar">
        <text class="avatar-icon">👤</text>
      </view>
      <view class="user-info">
        <text class="user-name">未登录</text>
        <text class="user-sub">登录后享受更多权益</text>
      </view>
      <button class="btn-login" bindtap="doLogin">立即登录</button>
    </view>

    <!-- 已登录 -->
    <view wx:else class="user-row">
      <view class="avatar-wrap">
        <image wx:if="{{userInfo.avatar}}" class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill" />
        <text wx:else class="avatar-icon">👤</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName || userInfo.username || '灵狐用户'}}</text>
        <text class="user-sub">ID: {{userInfo.userId || ''}}</text>
      </view>
    </view>
  </view>

  <!-- 资产卡 -->
  <view class="asset-card" bindtap="goCoupons">
    <view class="asset-item">
      <text class="asset-num orange">{{couponCount}}</text>
      <text class="asset-label">优惠券</text>
    </view>
    <view class="asset-divider"></view>
    <view class="asset-item">
      <text class="asset-num">0</text>
      <text class="asset-label">积分</text>
    </view>
    <view class="asset-divider"></view>
    <view class="asset-item">
      <text class="asset-num">0</text>
      <text class="asset-label">收藏</text>
    </view>
  </view>

  <!-- 我的订单 -->
  <view class="section-card">
    <view class="section-header" bindtap="goAllOrders">
      <text class="section-title">我的订单</text>
      <text class="section-more">全部订单 ›</text>
    </view>
    <view class="order-tabs">
      <view wx:for="{{orderTabs}}" wx:key="status"
        class="order-tab" bindtap="goOrders" data-status="{{item.status}}">
        <text class="tab-icon">{{item.icon}}</text>
        <text class="tab-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="goCoupons">
      <text class="menu-icon">🎟️</text>
      <text class="menu-label">我的优惠券</text>
      <view class="menu-right">
        <text wx:if="{{couponCount > 0}}" class="menu-badge">{{couponCount}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="contactService">
      <text class="menu-icon">📞</text>
      <text class="menu-label">联系客服</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-label">关于灵狐近选</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view wx:if="{{isLoggedIn}}" class="logout-wrap">
    <button class="btn-logout" bindtap="logout">退出登录</button>
  </view>

  <view style="height: 60rpx;"></view>

</view>
