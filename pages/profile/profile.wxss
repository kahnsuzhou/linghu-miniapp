/* pages/profile/profile.wxss */

.container {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 顶部背景 */
.header-bg {
  background: linear-gradient(135deg, #FF6B35 0%, #ff8c5a 100%);
  padding: 40rpx 24rpx 80rpx;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  border: 3rpx solid rgba(255,255,255,0.6);
}

.avatar-img { width: 100%; height: 100%; }
.avatar-icon { font-size: 50rpx; }

.user-info { flex: 1; }
.user-name {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 6rpx;
}
.user-sub {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

.btn-login {
  padding: 0 28rpx;
  height: 60rpx;
  background: #fff;
  color: #FF6B35;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: bold;
  border: none;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.btn-login::after { border: none; }

/* 资产卡 */
.asset-card {
  background: #fff;
  margin: -40rpx 24rpx 16rpx;
  border-radius: 20rpx;
  padding: 32rpx 0;
  display: flex;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.asset-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.asset-divider {
  width: 1rpx;
  background: #f0f0f0;
}

.asset-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}
.asset-num.orange { color: #FF6B35; }
.asset-label { font-size: 22rpx; color: #999; }

/* 通用区块 */
.section-card, .menu-card {
  background: #fff;
  margin: 0 0 16rpx;
  padding: 0 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 16rpx;
}
.section-title { font-size: 28rpx; font-weight: bold; color: #222; }
.section-more { font-size: 24rpx; color: #999; }

/* 订单快捷入口 */
.order-tabs {
  display: flex;
  padding-bottom: 24rpx;
}
.order-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.tab-icon { font-size: 40rpx; }
.tab-label { font-size: 22rpx; color: #666; }

/* 菜单 */
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 16rpx;
}
.menu-item:last-child { border-bottom: none; }

.menu-icon { font-size: 36rpx; }
.menu-label { flex: 1; font-size: 28rpx; color: #333; }
.menu-right { display: flex; align-items: center; gap: 8rpx; }
.menu-badge {
  background: #FF6B35;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}
.menu-arrow { font-size: 28rpx; color: #bbb; }

/* 退出 */
.logout-wrap { padding: 0 24rpx 0; }
.btn-logout {
  width: 100%;
  height: 88rpx;
  background: #fff;
  color: #ff4444;
  border: 1rpx solid #ffcfcf;
  border-radius: 44rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-logout::after { border: none; }

/* 钱包余额标签 */
.menu-balance {
  font-size: 24rpx;
  color: #FF6B35;
  font-weight: bold;
  margin-right: 8rpx;
}
