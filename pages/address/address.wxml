<!-- pages/address/address.wxml -->
<view class="container">

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
  </view>

  <block wx:elif="{{addresses.length > 0}}">
    <view class="addr-list">
      <view class="addr-card" wx:for="{{addresses}}" wx:key="id"
        bindtap="selectAddress" data-id="{{item.id}}">

        <!-- 默认标签 -->
        <view class="addr-header">
          <view class="addr-contact">
            <text class="addr-name">{{item.name}}</text>
            <text class="addr-phone">{{item.phone}}</text>
          </view>
          <view wx:if="{{item.isDefault}}" class="default-tag">默认</view>
        </view>

        <!-- 地址 -->
        <text class="addr-full">{{item.fullAddress}}</text>

        <!-- 操作栏 -->
        <view class="addr-actions">
          <view wx:if="{{!item.isDefault}}" class="action-btn" bindtap="setDefault" data-id="{{item.id}}">
            <text class="action-icon">☆</text>
            <text>设为默认</text>
          </view>
          <view class="action-btn" bindtap="editAddress" data-id="{{item.id}}">
            <text class="action-icon">✏️</text>
            <text>编辑</text>
          </view>
          <view class="action-btn danger" bindtap="deleteAddress" data-id="{{item.id}}">
            <text class="action-icon">🗑</text>
            <text>删除</text>
          </view>
        </view>

        <!-- 选中模式提示 -->
        <view wx:if="{{selectMode}}" class="select-hint">点击选择此地址</view>
      </view>
    </view>
  </block>

  <!-- 空状态 -->
  <view wx:elif="{{!loading}}" class="empty-wrap">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无收货地址</text>
  </view>

  <!-- 新增按钮 -->
  <view class="add-bar">
    <button class="btn-add" bindtap="addAddress">+ 新增收货地址</button>
  </view>

</view>
