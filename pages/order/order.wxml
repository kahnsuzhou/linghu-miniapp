<!-- pages/order/order.wxml -->
<view class="container">

  <!-- Tab 导航 -->
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="index"
      class="tab-item {{activeTab === index ? 'active' : ''}}"
      bindtap="switchTab" data-index="{{index}}">
      <text class="tab-label">{{item.label}}</text>
      <view wx:if="{{activeTab === index}}" class="tab-indicator"></view>
    </view>
  </view>

  <!-- 订单列表 -->
  <scroll-view scroll-y class="order-list" refresher-enabled
    refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh"
    bindscrolltolower="loadMore">

    <!-- loading -->
    <view wx:if="{{loading && orders.length === 0}}" class="loading-wrap">
      <view class="loading-spinner"></view>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{orders.length === 0}}" class="empty-wrap">
      <text class="empty-icon">📦</text>
      <text class="empty-title">暂无订单</text>
      <text class="empty-sub">去首页逛逛，发现好货</text>
      <button class="btn-go-shop" bindtap="goShopping">去购物</button>
    </view>

    <!-- 订单卡片 -->
    <view wx:else>
      <view wx:for="{{orders}}" wx:key="id"
        class="order-card" bindtap="goDetail" data-id="{{item.id}}">

        <!-- 卡片头部：仓库+状态 -->
        <view class="card-header">
          <text class="warehouse-name">🏪 {{item.warehouseName || '灵狐仓库'}}</text>
          <text class="status-text" style="color: {{item.statusColor}}">{{item.statusLabel}}</text>
        </view>

        <!-- 商品行 -->
        <view class="card-product">
          <image class="product-thumb" src="{{item.thumb}}" mode="aspectFill" />
          <view class="product-detail">
            <text class="product-name">{{item.itemName}}</text>
            <text wx:if="{{item.itemCount > 1}}" class="more-items">等{{item.itemCount}}件商品</text>
            <text class="order-sn">订单号：{{item.orderSn}}</text>
          </view>
        </view>

        <!-- 金额 + 操作 -->
        <view class="card-footer">
          <text class="order-time">{{item.timeStr}}</text>
          <view class="card-actions" catchtap="stopPropagation">
            <!-- 待付款：可取消 -->
            <button wx:if="{{item.status === 'PENDING_PAYMENT'}}" class="btn-outline"
              catchtap="cancelOrder" data-id="{{item.id}}">取消</button>
            <!-- 待自提：查看自提码 -->
            <button wx:if="{{item.status === 'PENDING_DELIVERY' || item.status === 'DELIVERING'}}"
              class="btn-primary" catchtap="goDetail" data-id="{{item.id}}">查看自提码</button>
            <!-- 其他状态只看详情 -->
            <button wx:if="{{item.status === 'FINISHED' || item.status === 'CANCELLED'}}"
              class="btn-outline" catchtap="goDetail" data-id="{{item.id}}">查看详情</button>
          </view>
          <text class="total-amount">实付 ¥{{item.priceStr}}</text>
        </view>

      </view>

      <!-- 加载更多 -->
      <view wx:if="{{hasMore}}" class="load-more">上拉加载更多</view>
      <view wx:else class="load-end">— 已显示全部订单 —</view>
    </view>

  </scroll-view>

</view>
