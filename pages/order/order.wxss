/* pages/order/order.wxss */

.container {
  background: #f5f5f5;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Tab 导航 */
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
  overflow-x: auto;
}
.tabs::-webkit-scrollbar { display: none; }

.tab-item {
  flex: 1;
  min-width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx 0;
  position: relative;
  white-space: nowrap;
}

.tab-label {
  font-size: 26rpx;
  color: #666;
  padding-bottom: 16rpx;
}

.tab-item.active .tab-label {
  color: #FF6B35;
  font-weight: bold;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #FF6B35;
  border-radius: 2rpx;
}

/* 订单列表 */
.order-list {
  flex: 1;
  overflow: hidden;
}

/* loading */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}
.loading-spinner {
  width: 60rpx; height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #FF6B35;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* 空状态 */
.empty-wrap {
  padding: 120rpx 0 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.empty-icon { font-size: 100rpx; }
.empty-title { font-size: 30rpx; color: #999; }
.empty-sub { font-size: 24rpx; color: #bbb; }
.btn-go-shop {
  margin-top: 12rpx;
  padding: 16rpx 48rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}
.btn-go-shop::after { border: none; }

/* 订单卡片 */
.order-card {
  background: #fff;
  margin: 16rpx 16rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 0 24rpx;
}
.order-card:last-child { margin-bottom: 16rpx; }

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.warehouse-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.status-text {
  font-size: 26rpx;
  font-weight: bold;
}

/* 商品行 */
.card-product {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
}
.product-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}
.product-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.product-name {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.more-items { font-size: 22rpx; color: #999; }
.order-sn { font-size: 20rpx; color: #bbb; }

/* 卡片底部 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 20rpx;
  border-top: 1rpx solid #f5f5f5;
  flex-wrap: wrap;
  gap: 8rpx;
}
.order-time { font-size: 22rpx; color: #bbb; }
.total-amount { font-size: 26rpx; color: #FF6B35; font-weight: bold; }

.card-actions { display: flex; gap: 12rpx; }

.btn-primary, .btn-outline {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.btn-primary::after, .btn-outline::after { border: none; }

.btn-primary {
  background: linear-gradient(135deg, #FF6B35, #ff8c5a);
  color: #fff;
  border: none;
}
.btn-outline {
  background: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}

/* 加载更多 */
.load-more, .load-end {
  text-align: center;
  padding: 24rpx 0;
  font-size: 22rpx;
  color: #bbb;
}
