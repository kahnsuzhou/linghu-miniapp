/* pages/wallet/wallet.wxss */
.container {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 余额卡片 */
.balance-card {
  background: linear-gradient(135deg, #FF6B35 0%, #ff9a5c 100%);
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.balance-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 12rpx;
}
.balance-amount {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  margin-bottom: 12rpx;
}
.balance-symbol {
  font-size: 36rpx;
  color: #fff;
  font-weight: 500;
  padding-bottom: 10rpx;
}
.balance-number {
  font-size: 88rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
  letter-spacing: -2rpx;
}
.balance-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-bottom: 32rpx;
}
.recharge-btn {
  background: #fff;
  color: #FF6B35;
  font-size: 28rpx;
  font-weight: bold;
  padding: 16rpx 60rpx;
  border-radius: 40rpx;
  letter-spacing: 2rpx;
}
.recharge-btn:active { opacity: 0.85; }

/* 快捷充值面板 */
.quick-amounts {
  background: #fff;
  margin: 16rpx 0;
  padding: 28rpx 32rpx;
}
.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #222;
}
.section-close {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
  padding: 0 8rpx;
}

.amount-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.amount-item {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  background: #fafafa;
}
.amount-item.active {
  border-color: #FF6B35;
  background: #fff3ed;
  color: #FF6B35;
}

.custom-amount-row {
  display: flex;
  align-items: center;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
  margin-bottom: 20rpx;
}
.custom-label {
  font-size: 26rpx;
  color: #666;
  width: 120rpx;
  flex-shrink: 0;
}
.custom-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}
.custom-unit {
  font-size: 26rpx;
  color: #999;
}

.recharge-tip {
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
  margin-bottom: 20rpx;
}

.btn-confirm {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B35, #ff8c5a);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-confirm::after { border: none; }
.btn-confirm.loading { background: #ccc; }

/* 菜单行 */
.menu-row {
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}
.menu-row-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.menu-icon { font-size: 36rpx; }
.menu-label {
  font-size: 28rpx;
  color: #333;
  display: block;
}
.menu-desc {
  font-size: 22rpx;
  color: #bbb;
  display: block;
  margin-top: 4rpx;
}
.menu-arrow { font-size: 28rpx; color: #bbb; }
.menu-arrow.orange { color: #FF6B35; font-size: 24rpx; }

/* 流水记录 */
.section-card {
  background: #fff;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}
.tx-loading, .tx-empty {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #bbb;
}
.tx-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.tx-item:last-child { border-bottom: none; }
.tx-left { flex: 1; }
.tx-type { display: block; font-size: 28rpx; color: #333; margin-bottom: 6rpx; }
.tx-time { display: block; font-size: 22rpx; color: #bbb; }
.tx-right { text-align: right; }
.tx-amount { display: block; font-size: 30rpx; font-weight: bold; margin-bottom: 6rpx; }
.tx-amount.income { color: #FF6B35; }
.tx-amount.expense { color: #333; }
.tx-balance { display: block; font-size: 22rpx; color: #bbb; }

.load-more, .no-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #bbb;
}
.load-more { color: #FF6B35; }
